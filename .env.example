# Public site URL (used for canonical tags, sitemap, hreflang). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google Maps Embed API key (FREE, unlimited requests — used only to display the
# small map on each cafe page). Restrict this key to the Maps Embed API + your
# domain in the Google Cloud console. The "Get directions" button needs no key.
NEXT_PUBLIC_GMAPS_EMBED_KEY=

# Mapillary access token (FREE, unmetered) — used at runtime by
# /api/mapillary-photo to resolve street-level cafe photos to fresh thumbnails, and
# by `npm run mapillary` to build data/mapillary.json. Format: MLY|<app id>|<secret>.
# Get one at https://www.mapillary.com/dashboard/developers. Same value goes in the
# MAPILLARY_TOKEN repo secret so the mapillary.yml Action can refresh new cafes.
MAPILLARY_TOKEN=

# --- Only needed once you move off seed JSON to a real database (Phase B) ---
# Supabase / Postgres connection (with PostGIS enabled). See db/schema.sql.
# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Only needed to run the Claude enrichment script (scripts/enrich.mjs) ---
# ANTHROPIC_API_KEY=
